# GPU variant: CUDA + onnxruntime-gpu (linux amd64/aarch64 only).
# Not built by CI — the camp runs on CPU. Build it by hand when a GPU node is
# worth the extra image size, and switch the deployment to this tag:
#   docker build -f Dockerfile.gpu -t registry.kevyn.com.br/ip-alpha/kids/acampa-2025-face:<ver>-gpu .
# Then add `runtimeClassName: nvidia` and `nvidia.com/gpu: "1"` to face-service.yaml.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH=/opt/venv/bin:$PATH \
    FACE_MODEL_ROOT=/app/data/insightface

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential python3 python3-dev python3-venv libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-gpu.txt ./
RUN python3 -m venv /opt/venv \
    && pip install --upgrade pip setuptools wheel \
    && pip install "numpy==1.26.4" "cython==3.0.11" \
    && pip install -r requirements-gpu.txt

COPY face_service ./face_service
EXPOSE 8000
CMD ["uvicorn", "face_service.app:app", "--host", "0.0.0.0", "--port", "8000"]
